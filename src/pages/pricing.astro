---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING_PACKAGES, UNIT_PRICE_ITEMS, PRICE_CATEGORIES } from '../data/pricing.ts';
---
<BaseLayout
  title="Ціни на дизайн інтер'єру та ремонт квартир у Львові — Прайс-лист 358"
  description="Відкритий прайс-лист студії 358 у Львові: базові пакети за м² (Комплекс під ключ, Дизайн-проєкт, Ремонтні роботи) та розцінки за одиницю робіт із пошуком і фільтрацією."
  canonicalPath="/pricing"
  basePrefix=".."
>
  <section class="page-hero">
    <h1>Ціни та відкритий прайс-лист робіт</h1>
    <p class="page-lead">
      Прозорі орієнтири вартості за квадратний метр та детальні розцінки за одиницю будівельних і оздоблювальних робіт у Львові.
    </p>
  </section>
</BaseLayout>

