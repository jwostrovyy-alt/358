---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TEAM_PROFILES } from '../data/site.ts';
---
<BaseLayout
  title="Про нас — Сімейний тандем архітектора Наталі та будівельника Віталія • 358"
  description="Історія та принципи студії 358 у Львові: Наталя (46 років, магістр архітектури, 20+ років стажу) та Віталій (46 років, 10+ років практичного досвіду у ремонтах). Пропорції золотого перерізу 3:5:8."
  canonicalPath="/about"
  basePrefix=".."
>
  <section class="page-hero">
    <h1>Про тандем «358» та філософію роботи</h1>
    <p class="page-lead">
      Поєднання архітектурної освіти, 20-річного досвіду проєктування та 10-річної інженерно-будівельної практики в одній родині.
    </p>
  </section>
</BaseLayout>

