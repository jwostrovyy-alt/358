---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PORTFOLIO_ITEMS } from '../../data/content-items.ts';
---
<BaseLayout
  title="Портфоліо реалізованих об'єктів та дизайн-проєктів — Студія 358 • Львів"
  description="Реалізовані ремонти квартир під ключ у Львові та архітектурні дизайн-проєкти від студії 358. Кейс власної смарт-квартири 27 м², ЖК Велика Британія, ЖК Avalon."
  canonicalPath="/portfolio"
  basePrefix=".."
>
  <section class="page-hero">
    <h1>Портфоліо об'єктів та проєктів</h1>
    <p class="page-lead">
      Реальні квартири у Львові, виконані під ключ, процеси чистового оздоблення та розроблені альбоми робочих креслень.
    </p>
  </section>
</BaseLayout>

