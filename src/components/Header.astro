---
import { SITE_CONFIG, NAV_ITEMS } from '../data/site.ts';
import Logo358 from './Logo358.astro';

export interface Props {
  currentPath?: string;
  basePrefix?: string;
}
const { currentPath = '/', basePrefix = '.' } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <Logo358 basePrefix={basePrefix} />
    <button
      type="button"
      class="mobile-menu-toggle"
      aria-expanded="false"
      aria-label="Відкрити меню навігації"
      onclick="toggleMobileNav(this)"
    >
      <span class="mobile-menu-label">Меню</span>
    </button>
    <nav class="site-nav" id="siteNav" aria-label="Основна навігація">
      {NAV_ITEMS.map((item) => {
        const href = item.href === '/' ? `${basePrefix}/` : `${basePrefix}${item.href}/`;
        const isActive = currentPath === item.href;
        return (
          <a href={href} class={isActive ? 'site-nav__link active' : 'site-nav__link'}>
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="header-contacts">
      <a href={SITE_CONFIG.phoneHref} class="chip-link">{SITE_CONFIG.phoneDisplay}</a>
    </div>
  </div>
</header>

