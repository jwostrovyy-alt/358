---
import { SITE_CONFIG } from '../data/site.ts';
---
<footer class="site-footer" id="contacts">
  <div class="site-footer__inner">
    <div>
      <div class="site-footer__brand">358</div>
      <div class="site-footer__copy">© 2026 Студія дизайну та ремонту «358» • Львів, Україна</div>
    </div>
    <div class="site-footer__links">
      <a href={SITE_CONFIG.phoneHref} class="site-footer__phone">{SITE_CONFIG.phoneDisplay}</a>
      <a href={SITE_CONFIG.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram</a>
      <a href={SITE_CONFIG.viberUrl}>Viber</a>
      <a href={SITE_CONFIG.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube «{SITE_CONFIG.youtubeChannelName}»</a>
    </div>
  </div>
</footer>

